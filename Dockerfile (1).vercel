FROM dunglas/frankenphp:php8.3-bookworm

WORKDIR /app

# PHP extensions needed by DaniTrans and the future Supabase/PostgreSQL connection.
RUN install-php-extensions mysqli pdo_pgsql pgsql

# Copy the DaniTrans project into the container.
COPY . /app

# Vercel provides PORT at runtime.
CMD ["sh", "-c", "frankenphp php-server --listen :${PORT:-80} --root /app"]
